rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'contato.auramvp@gmail.com' ||
        request.auth.token.email == 'adm.racing@sistema.com'
      );
    }

    // Admin Master Rule
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Coleções públicas do site (leitura)
    match /highlights/{id} { allow read: if true; }
    match /trophies/{id} { allow read: if true; }
    match /transparency/{id} { allow read: if true; }
    match /news/{id} { 
      allow read: if true; 
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }
    match /players/{id} { allow read: if true; }
    match /board/{id} { allow read: if true; }
    match /campaigns/{id} { allow read: if true; }
    match /test/connection { allow read: if true; }

    // Coleções públicas para envio de formulários (escrita)
    match /registrations/{id} { allow create: if true; }
    match /socio_leads/{id} { allow create: if true; }

    // user_permissions: qualquer um pode verificar um e-mail específico (GET)
    // mas só autenticados podem listar e só admin pode escrever
    match /user_permissions/{email} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if isAdmin();
    }

    // Todas as outras coleções: autenticados podem ler, só admin escreve
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}