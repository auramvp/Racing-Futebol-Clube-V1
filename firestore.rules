rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && 
             'email' in request.auth.token && (
               request.auth.token.email == 'contato.auramvp@gmail.com' ||
               request.auth.token.email == 'adm.racing@sistema.com'
             );
    }

    // Coleções públicas do site
    match /highlights/{id} { allow read: if true; }
    match /trophies/{id} { allow read: if true; }
    match /transparency/{id} { allow read: if true; }
    match /news/{id} { allow read: if true; }
    match /test/connection { allow read: if true; }

    // user_permissions: qualquer um pode verificar um e-mail específico (GET)
    // mas só autenticados podem listar e só admin pode escrever
    match /user_permissions/{email} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if isAdmin();
    }

    // Todas as outras coleções: autenticados podem ler, só admin escreve
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}